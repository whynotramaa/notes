---
import Note from '../../../layouts/Note.astro';
---
<Note ch={2} description="RMSNorm versus LayerNorm: the computation step by step, geometry on a circle, invariances, learned gains, cost, placement in modern blocks, epsilon, and a reference implementation.">
  <header class="hero">
    <div>
      <p class="kicker">chapter 02</p>
      <h1><span>RMSNorm</span></h1>
      <p class="lede">LayerNorm does two things: it re-centres a vector to mean zero and rescales it to unit size.</p>
    </div>
  </header>

  <h2>The computation</h2>
  <div class="formula">LayerNorm(x) = <em>(x − mean) / √(var + ε)</em> · γ + β &nbsp; &nbsp; RMSNorm(x) = <em>x / √(mean(x²) + ε)</em> · γ</div>
  <figure class="fig" id="steps">
    <div class="fig-head"><h3>Side by side, one step at a time</h3></div>
  </figure>

  <figure class="fig" id="geometry">
    <div class="fig-head"><h3>What the two norms do geometrically</h3></div>
  </figure>

  <figure class="fig" id="invariance">
    <div class="fig-head"><h3>What each norm ignores</h3></div>
  </figure>

  <h2>The learned part</h2>
  <figure class="fig" id="gain">
    <div class="fig-head"><h3>The gain γ: one learned number per channel</h3></div>
  </figure>

  <figure class="fig" id="cost">
    <div class="fig-head"><h3>What you save</h3></div>
  </figure>

  <h2>Where the norms sit</h2>
  <figure class="fig" id="placement">
    <div class="fig-head"><h3>Pre-norm, sandwich norm, QK-norm</h3></div>
  </figure>

  <figure class="fig" id="epsilon">
    <div class="fig-head"><h3>What ε does</h3></div>
  </figure>

  <figure class="fig" id="impl">
    <div class="fig-head"><h3>A reference implementation</h3></div>
  </figure>

  <h2>Exceptions and sharp edges</h2>
  <div class="edges">
    <article class="edge redraw" id="e-gemma"><div class="art"></div><h4>Gemma stores γ − 1</h4><span class="fix">check how the weight is applied before porting.</span></article>
    <article class="edge redraw" id="e-upcast"><div class="art"></div><h4>Squaring in bf16</h4><span class="fix">x.float() before pow, cast back after.</span></article>
    <article class="edge redraw" id="e-wd"><div class="art"></div><h4>Weight decay on γ</h4><span class="fix">exclude norm weights and biases from weight decay.</span></article>
    <article class="edge redraw" id="e-eps"><div class="art"></div><h4>ε inside or outside the root</h4><span class="fix">match the reference implementation exactly.</span></article>
    <article class="edge redraw" id="e-outlier"><div class="art"></div><h4>Outlier channels</h4><span class="fix">keep norms in higher precision; handle outliers in int8 schemes.</span></article>
  </div>

  <Fragment slot="scripts"><script is:inline>
const { fig, box, rect, o, arr, carr, ln, node, chip, heat, vec, bars, axes, smooth, cross, check, squig, clamp, map, gauss, mean, std, code, norm } = Ink;
const x0 = [1.2, -0.4, 2.6, 0.8, -1.1, 3.0, 0.2, 1.7];
const ln_ = x => { const m = mean(x), s = std(x); return x.map(v => (v - m) / Math.sqrt(s * s + 1e-5)); };
const rms_ = x => { const r = Math.sqrt(mean(x.map(v => v * v)) + 1e-5); return x.map(v => v / r); };

fig('steps', {
  view: '0 0 980 430', hue: 150,
  label: 'Two columns of number strips. LayerNorm: input, subtract the mean, divide by the standard deviation, multiply by gamma and add beta. RMSNorm: input, divide by the root mean square, multiply by gamma.',
  draw(sk, st) {
    const m = mean(x0), s = std(x0), r = Math.sqrt(mean(x0.map(v => v * v)));
    const cen = x0.map(v => v - m), lnv = cen.map(v => v / s), rmv = x0.map(v => v / r);
    const L = [['x', x0, ''], ['x − mean', cen, `mean = ${m.toFixed(2)}`], ['÷ std', lnv, `std = ${s.toFixed(2)}`], ['· γ + β', lnv, 'γ = 1, β = 0 here']];
    const R = [['x', x0, ''], ['÷ rms', rmv, `rms = ${r.toFixed(2)}`], ['· γ', rmv, 'γ = 1 here']];
    sk.hand(250, 30, 'LayerNorm', 26, -3); sk.hand(740, 30, 'RMSNorm', 26, -3, { c: 'tint' });
    L.slice(0, Math.min(st.step + 1, 4)).forEach(([t, v, n], i) => { const y = 54 + i * 88; sk.mono(30, y + 18, t, { a: 'start', s: 12 }); vec(sk, v, 30, y + 26, 54, 32, { nums: true, max: 3, fmt: q => q.toFixed(2), numS: 10.5 }); if (n) sk.mono(470, y + 18, n, { a: 'end', s: 11, c: 'muted' }); });
    R.slice(0, Math.min(st.step + 1, 3)).forEach(([t, v, n], i) => { const y = 54 + i * 88; sk.mono(510, y + 18, t, { a: 'start', s: 12 }); vec(sk, v, 510, y + 26, 54, 32, { nums: true, max: 3, fmt: q => q.toFixed(2), numS: 10.5 }); if (n) sk.mono(950, y + 18, n, { a: 'end', s: 11, c: 'muted' }); });
    sk.thin('M490 50V420');
    if (st.step >= 3) { sk.mono(250, 420, '2 reductions · 2d params', { s: 12 }); sk.mono(740, 420, '1 reduction · d params', { s: 12, c: 'tint' }); }
  },
  controls: c => c.player('step', 4, { ms: 1200, name: 'step' })
});

fig('geometry', {
  view: '0 0 980 400', hue: 150, state: { x: 1.6, y: 0.5 },
  label: 'A 2D plane with a circle of radius root 2 and the diagonal line where x plus y equals zero. The input point, its RMSNorm output on the circle in the same direction, and its LayerNorm output at one of the two points where the line meets the circle.',
  draw(sk, st) {
    const cx = 300, cy = 200, U = 70, P = (a, b) => [cx + a * U, cy - b * U];
    sk.thin(`M${cx - 260} ${cy}H${cx + 260}M${cx} ${cy - 190}V${cy + 190}`);
    sk.ink(o(cx, cy, Math.SQRT2 * U));
    sk.dash(`M${P(-2.6, 2.6)}L${P(2.6, -2.6)}`);
    const v = [st.x, st.y], r = Math.sqrt((v[0] ** 2 + v[1] ** 2) / 2) || 1e-9, rm = v.map(q => q / r);
    const m = (v[0] + v[1]) / 2, c = v.map(q => q - m), s = Math.sqrt((c[0] ** 2 + c[1] ** 2) / 2) || 1e-9, lnv = c.map(q => q / s);
    const [ix, iy] = P(...v), [rx, ry] = P(...rm), [lx, ly] = P(...lnv), [px, py] = P(...c);
    sk.ink(arr(cx, cy, ix, iy)); sk.paper(o(ix, iy, 7)); sk.ink(o(ix, iy, 7)); sk.hand(ix + 16, iy - 10, 'x', 22, 0, { a: 'start' });
    sk.accent(o(rx, ry, 9)); sk.ink(o(rx, ry, 9)); sk.hand(rx + 16, ry + 20, 'RMSNorm', 19, -4, { a: 'start', c: 'tint' });
    sk.dash(`M${ix} ${iy}L${px} ${py}`); sk.paper(o(px, py, 5)); sk.ink(o(px, py, 5));
    sk.ink(o(lx, ly, 9)); sk.ink(cross(lx, ly, 6)); sk.hand(lx - 14, ly + 26, 'LayerNorm', 19, 4, { a: 'end' });
    sk.mono(cx + 4, cy + Math.SQRT2 * U + 18, 'radius √d', { a: 'start', s: 11 });
    sk.mono(P(2.3, -2.3)[0], P(2.3, -2.3)[1] + 16, 'mean = 0 line', { s: 11 });
    sk.serif(760, 110, 'in d dimensions', 22);
    sk.text(760, 150, 'RMSNorm: radial projection onto a sphere', { s: 19 });
    sk.text(760, 180, 'LayerNorm: drop the (1,1,…,1) direction,', { s: 19 });
    sk.text(760, 204, 'then project onto the sphere', { s: 19 });
    sk.hand(760, 270, 'in 2D, LayerNorm has only 2 possible outputs!', 19, -2, { c: 'redt' });
  },
  controls: c => c.slider('x', 'x₁', -2.5, 2.5, 0.05, v => v.toFixed(2)).slider('y', 'x₂', -2.5, 2.5, 0.05, v => v.toFixed(2))
});

fig('invariance', {
  view: '0 0 980 360', hue: 150, state: { a: 1, b: 0 },
  label: 'Three bar charts: the transformed input alpha times x plus beta, the LayerNorm output and the RMSNorm output. Ticks or crosses mark whether each output matches the output for the original x.',
  draw(sk, st) {
    const xin = x0.map(v => st.a * v + st.b), l0 = ln_(x0), r0 = rms_(x0), l1 = ln_(xin), r1 = rms_(xin);
    const panel = (v, x, t, ref) => {
      const Y = q => map(clamp(q, -4, 7), -4, 7, 300, 60);
      sk.thin(`M${x - 6} ${Y(0)}H${x + 280}`);
      v.forEach((q, i) => { const bx = x + i * 34, p = `M${bx} ${Math.min(Y(0), Y(q))}H${bx + 26}V${Math.max(Y(0), Y(q))}H${bx}Z`; sk.cell(p, 0.7, q < 0); sk.ink(p); });
      sk.hand(x + 136, 40, t, 22, -2);
      if (ref) { const same = v.every((q, i) => Math.abs(q - ref[i]) < 1e-6); same ? sk.ink(check(x + 120, 336, 0.8)) : sk.red(cross(x + 136, 330, 10)); sk.mono(x + 170, 336, same ? 'unchanged' : 'changed', { a: 'start', s: 11, c: same ? '' : 'redt' }); }
    };
    panel(xin, 30, `${st.a.toFixed(1)} · x + ${st.b.toFixed(1)}`);
    panel(l1, 350, 'LayerNorm', l0);
    panel(r1, 670, 'RMSNorm', r0);
  },
  controls: c => c.slider('a', 'Scale α', 0.2, 4, 0.1, v => v.toFixed(1)).slider('b', 'Shift β', -3, 3, 0.1, v => v.toFixed(1))
});

const gam = Array.from({ length: 24 }, (_, i) => +(1 + gauss(i, 4) * 0.25 + (i === 7 ? 4.2 : i === 18 ? 2.8 : 0)).toFixed(2));
fig('gain', {
  view: '0 0 980 320', hue: 150,
  label: 'Bar chart of 24 learned gain values, mostly near 1, with two outlier channels much larger.',
  draw(sk) {
    axes(sk, 70, 40, 860, 220, { xl: 'channel', yl: 'γ' });
    bars(sk, gam, 80, 50, 840, 210, { hiSet: new Set([7, 18]), alpha: 0.3 });
    sk.dash(`M70 ${260 - 210 / Math.max(...gam)}H930`); sk.mono(64, 264 - 210 / Math.max(...gam), '1', { a: 'end', s: 11 });
    sk.hand(300, 70, 'outlier channels', 21, -4, { c: 'tint' });
    sk.mono(500, 300, 'RMSNorm: γ only (d numbers) · LayerNorm: γ and β (2d numbers)', { s: 12 });
  }
});

fig('cost', {
  view: '0 0 980 300', hue: 150,
  label: 'Grouped bars comparing LayerNorm and RMSNorm on reductions per vector, elementwise passes, and parameters per norm.',
  draw(sk) {
    const groups = [['reductions', 2, 1], ['elementwise passes', 4, 2], ['params (× d)', 2, 1]];
    groups.forEach(([t, a, b], i) => {
      const x = 90 + i * 300, H = v => v * 50;
      const pa = `M${x} ${250 - H(a)}h80V250h-80Z`, pb = `M${x + 100} ${250 - H(b)}h80V250h-80Z`;
      sk.cell(pa, 0.3); sk.ink(pa); sk.accent(pb); sk.ink(pb);
      sk.mono(x + 40, 240 - H(a), String(a), { s: 13 }); sk.mono(x + 140, 240 - H(b), String(b), { s: 13 });
      sk.hand(x + 90, 284, t, 20, -1);
    });
    sk.thin('M60 250H940');
    sk.hand(760, 40, 'LayerNorm (pale) · RMSNorm (accent)', 19, -2);
  }
});

const layouts = {
  llama: { n: 'pre-norm (Llama)', post: false, qk: false },
  gemma: { n: 'sandwich (Gemma 2)', post: true, qk: false },
  qk: { n: 'pre-norm + QK-norm (OLMo 2 style)', post: false, qk: true },
};
fig('placement', {
  view: '0 0 980 420', hue: 150, state: { k: 'llama' },
  label: 'A decoder block diagram with RMSNorm boxes highlighted wherever the chosen design places them: before attention and MLP, optionally after them, and optionally on q and k.',
  draw(sk, st) {
    const L = layouts[st.k], X = 220;
    sk.ink(arr(X, 400, X, 20));
    const nb = (x, y, on) => node(sk, x, y, 110, 30, 'RMSNorm', { font: 'mono', s: 11, fill: on ? 'accent' : 'paper' });
    sk.ink(`M${X} 362H${X + 60}`); nb(X + 60, 347, true);
    node(sk, X + 200, 282, 220, 60, 'attention', { s: 22 }); sk.ink(carr(X + 172, 362, X + 240, 344, 10));
    if (L.qk) { node(sk, X + 440, 290, 70, 22, 'q norm', { font: 'mono', s: 10, fill: 'accent' }); node(sk, X + 440, 316, 70, 22, 'k norm', { font: 'mono', s: 10, fill: 'accent' }); sk.ink(arr(X + 438, 312, X + 422, 312)); }
    if (L.post) { nb(X + 255, 236, true); sk.ink(arr(X + 310, 280, X + 310, 268)); }
    sk.paper(o(X, 220, 13)); sk.ink(o(X, 220, 13)); sk.hand(X, 227, '+', 22); sk.ink(carr(X + (L.post ? 255 : 200), L.post ? 250 : 300, X + 14, 222, -14));
    sk.ink(`M${X} 186H${X + 60}`); nb(X + 60, 171, true);
    node(sk, X + 200, 110, 220, 56, 'SwiGLU MLP', { s: 22 }); sk.ink(carr(X + 172, 186, X + 240, 168, 10));
    if (L.post) { nb(X + 255, 64, true); sk.ink(arr(X + 310, 108, X + 310, 96)); }
    sk.paper(o(X, 52, 13)); sk.ink(o(X, 52, 13)); sk.hand(X, 59, '+', 22); sk.ink(carr(X + (L.post ? 255 : 200), L.post ? 78 : 128, X + 14, 54, -14));
    nb(40, 4, true); sk.mono(95, 48, 'final norm (after last block)', { s: 10, c: 'muted' });
    sk.serif(800, 200, L.n, 22);
    const cnt = 2 + (L.post ? 2 : 0) + (L.qk ? 2 : 0);
    sk.mono(800, 230, `${cnt} norms per block`, { s: 13 });
  },
  controls: c => c.choice('k', 'Design', [['llama', 'Llama'], ['gemma', 'Gemma 2'], ['qk', 'QK-norm']])
});

fig('epsilon', {
  view: '0 0 980 340', hue: 150, state: { le: -5 },
  label: 'Log-log plot of output RMS against input RMS for RMSNorm. The output is flat at 1 for large inputs and falls off linearly once the input RMS drops below the square root of epsilon.',
  draw(sk, st) {
    const eps = 10 ** st.le, X = lv => map(lv, -8, 2, 90, 900), Y = lv => map(lv, -5, 0.5, 290, 40);
    axes(sk, 90, 40, 810, 250, { xl: 'input rms (log)', yl: 'output rms (log)' });
    const pts = []; for (let lv = -8; lv <= 2; lv += 0.1) { const r = 10 ** lv, out = r / Math.sqrt(r * r + eps); pts.push([X(lv), Y(Math.log10(out))]); }
    sk.plot(smooth(pts), 'pop');
    const knee = Math.log10(Math.sqrt(eps));
    sk.dash(`M${X(knee)} 40V290`); sk.mono(X(knee), 310, `√ε = 1e${(st.le / 2).toFixed(1)}`, { s: 11 });
    [-8, -6, -4, -2, 0, 2].forEach(v => sk.mono(X(v), 326, `1e${v}`, { s: 9.5, c: 'muted' }));
    sk.hand(X(0.5), Y(0) - 14, 'normal inputs → 1', 19, -2, { a: 'end' });
    sk.hand(X(-6), Y(-2.5), 'tiny inputs stay tiny', 19, -6, { c: 'tint' });
  },
  controls: c => c.slider('le', 'ε = 10^', -12, -2, 1, v => `1e${v}`)
});

fig('impl', {
  view: '0 0 980 330', hue: 150,
  label: 'A code card with a minimal RMSNorm module: weight initialised to ones, forward upcasts to float32, computes the mean of squares, multiplies by the reciprocal square root with epsilon, casts back and multiplies by the weight.',
  draw(sk) {
    code(sk, ['class RMSNorm(nn.Module):', '    def __init__(self, d, eps=1e-5):', '        super().__init__()', '        self.eps = eps', '        self.weight = nn.Parameter(torch.ones(d))', '', '    def forward(self, x):', '        dtype = x.dtype', '        x = x.float()', '        x = x * torch.rsqrt(x.pow(2).mean(-1, keepdim=True) + self.eps)', '        return self.weight * x.to(dtype)'], 30, 20, { w: 640, s: 12, lh: 26, hi: [8, 9] });
    sk.hand(830, 220, 'upcast first', 22, -4, { c: 'tint' }); sk.ink(arr(770, 226, 680, 244));
    sk.hand(830, 120, 'γ starts at 1, no β', 20, -3); sk.ink(arr(770, 126, 680, 136));
  }
});

const Ed = { view: '0 0 240 110', hue: 150 };
fig('e-gemma', { ...Ed, draw(sk) { sk.mono(120, 40, 'stored γ ≈ 0.02', { s: 13 }); sk.mono(120, 66, 'Gemma: x · (1 + γ)', { s: 12 }); sk.mono(120, 90, 'plain:  x · γ  → tiny', { s: 12, c: 'redt' }); } });
fig('e-upcast', { ...Ed, draw(sk) { sk.mono(120, 42, '300² in bf16 = 90112', { s: 12, c: 'redt' }); sk.mono(120, 70, '300² in fp32 = 90000', { s: 12 }); } });
fig('e-wd', { ...Ed, draw(sk) { bars(sk, [1, 0.8, 0.6, 0.45, 0.35], 50, 16, 140, 66, { max: 1, hi: 4 }); sk.mono(120, 104, 'γ under weight decay', { s: 10 }); } });
fig('e-eps', { ...Ed, draw(sk) { sk.mono(120, 42, '√(ms + ε)', { s: 14 }); sk.hand(120, 64, '≠', 22); sk.mono(120, 88, '√ms + ε', { s: 14, c: 'redt' }); } });
fig('e-outlier', { ...Ed, draw(sk) { bars(sk, [1, 1.2, 0.9, 14, 1.1, 0.8], 40, 14, 160, 70, { hi: 3 }); } });
  </script></Fragment>
</Note>
