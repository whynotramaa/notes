---
import Note from '../../../layouts/Note.astro';
---
<Note ch={5} description="PyTorch scaled_dot_product_attention drawn: replacing manual attention, backend dispatch, arguments, boolean mask semantics, causal alignment when query and key lengths differ, memory, tensor layout, and forcing a backend.">
  <header class="hero">
    <div>
      <p class="kicker">chapter 05</p>
      <h1><span>SDPA</span>: one call, three kernels</h1>
      <p class="lede">torch.nn.functional.scaled_dot_product_attention computes exactly the softmax(QKᵀ/√d)V from Day 1.</p>
    </div>
  </header>

  <h2>The call</h2>
  <figure class="fig" id="oneline">
    <div class="fig-head"><h3>Six lines become one</h3></div>
  </figure>

  <figure class="fig" id="args">
    <div class="fig-head"><h3>The arguments, drawn</h3></div>
  </figure>

  <h2>Which kernel runs</h2>
  <figure class="fig" id="dispatch">
    <div class="fig-head"><h3>The dispatcher's decision</h3></div>
  </figure>

  <figure class="fig" id="memory">
    <div class="fig-head"><h3>What the math fallback costs</h3></div>
  </figure>

  <h2>Masks</h2>
  <figure class="fig" id="boolmask">
    <div class="fig-head"><h3>Boolean masks: True means attend</h3></div>
  </figure>

  <figure class="fig" id="alignment">
    <div class="fig-head"><h3>is_causal when L ≠ S</h3></div>
  </figure>

  <h2>Shapes and control</h2>
  <figure class="fig" id="layout">
    <div class="fig-head"><h3>Getting into [B, h, T, d] and back</h3></div>
  </figure>

  <figure class="fig" id="force">
    <div class="fig-head"><h3>Forcing and checking a backend</h3></div>
  </figure>

  <h2>Exceptions and sharp edges</h2>
  <div class="edges">
    <article class="edge redraw" id="e-both"><div class="art"></div><h4>attn_mask and is_causal together</h4><span class="fix">fold causal into your explicit mask, or use only is_causal.</span></article>
    <article class="edge redraw" id="e-drop"><div class="art"></div><h4>dropout_p at eval time</h4><span class="fix">dropout_p = self.p if self.training else 0.0.</span></article>
    <article class="edge redraw" id="e-nan"><div class="art"></div><h4>Rows with nothing to see</h4><span class="fix">make sure every query can see at least one key.</span></article>
    <article class="edge redraw" id="e-fp32"><div class="art"></div><h4>fp32 skips Flash</h4><span class="fix">use autocast or cast the model to bf16.</span></article>
    <article class="edge redraw" id="e-scale"><div class="art"></div><h4>The default scale</h4><span class="fix">check the reference implementation's scale.</span></article>
  </div>

  <Fragment slot="scripts"><script is:inline>
const { fig, box, rect, o, arr, carr, ln, node, chip, heat, vec, bars, axes, smooth, cross, check, squig, clamp, map, gauss, code, fmtN, fmtBytes } = Ink;

fig('oneline', {
  view: '0 0 980 360', hue: 195,
  label: 'Left: a six-line manual attention implementation computing scores, scaling, masking, softmax, dropout and the value product. Right: a single scaled_dot_product_attention call. Arrows map groups of manual lines to the call.',
  draw(sk) {
    code(sk, ['scores = q @ k.transpose(-2, -1)', 'scores = scores / math.sqrt(d_h)', 'scores = scores.masked_fill(~mask, -inf)', 'p = scores.softmax(dim=-1)', 'p = dropout(p)', 'out = p @ v'], 20, 60, { w: 430, s: 12.5, lh: 34 });
    sk.hand(235, 40, 'Day 1', 22, -3);
    code(sk, ['out = F.scaled_dot_product_attention(', '    q, k, v,', '    is_causal=True,', '    dropout_p=p_drop if training else 0.0,', ')'], 540, 100, { w: 420, s: 12.5, lh: 34, hi: [0] });
    sk.hand(750, 80, 'Day 2', 22, -3, { c: 'tint' });
    [[94, 160], [128, 160], [162, 200], [196, 160], [230, 234], [264, 160]].forEach(([y1, y2], i) => sk.thin(`M452 ${y1}Q500 ${(y1 + y2) / 2} 538 ${y2}`));
    sk.hand(490, 330, 'scale, mask, softmax, dropout, matmul: all fused', 20, -1);
  }
});

fig('args', {
  view: '0 0 980 400', hue: 195,
  label: 'The SDPA signature with six argument cards: query, key and value with shapes; attn_mask broadcastable to L by S, boolean or float; dropout_p; is_causal; scale defaulting to one over root E; enable_gqa.',
  draw(sk) {
    sk.mono(490, 34, 'scaled_dot_product_attention(query, key, value, attn_mask=None, dropout_p=0.0,', { s: 13 });
    sk.mono(490, 56, 'is_causal=False, scale=None, enable_gqa=False)', { s: 13 });
    const cards = [['query', '[..., L, E]', 'what each new token asks'], ['key / value', '[..., S, E] / [..., S, Ev]', 'S may differ from L'], ['attn_mask', 'bool or float, → [..., L, S]', 'bool: True = attend · float: added'], ['dropout_p', 'float', 'set 0.0 at eval yourself'], ['is_causal', 'bool', 'top-left triangle, see fig 5.6'], ['scale', 'float or None', 'None → 1/√E'], ['enable_gqa', 'bool (PyTorch 2.5+)', 'K, V may have fewer heads']];
    cards.forEach(([t, sh, n], i) => {
      const x = 20 + (i % 4) * 240, y = 90 + Math.floor(i / 4) * 150, d = `M${x} ${y} ${x + 224} ${y - 1} ${x + 225} ${y + 130} ${x - 1} ${y + 131}Z`;
      sk.paper(d); if (i === 2 || i === 4) sk.accent(`M${x + 1} ${y + 1} ${x + 223} ${y} ${x + 224} ${y + 36} ${x + 1} ${y + 36}Z`); sk.ink(d);
      sk.hand(x + 112, y + 26, t, 22);
      sk.mono(x + 112, y + 64, sh, { s: 11 });
      sk.text(x + 112, y + 100, n, { s: 17, c: 'muted' });
    });
  }
});

fig('dispatch', {
  view: '0 0 980 420', hue: 195, state: { dt: 'bf16', mask: 'causal', hd: 128, cuda: true },
  label: 'A decision tree with three gates leading to FlashAttention, memory-efficient attention, or the math fallback. The path for the chosen inputs is highlighted and the chosen backend is filled.',
  draw(sk, st) {
    const half = st.dt !== 'fp32';
    const flash = st.cuda && half && st.hd <= 256 && st.mask !== 'tensor';
    const mem = !flash && st.cuda && st.hd <= 256;
    const pick = flash ? 'flash' : mem ? 'mem' : 'math';
    node(sk, 40, 180, 140, 54, 'q, k, v', { font: 'mono', s: 14, sub: `${st.dt} · d=${st.hd}` });
    const gate = (x, y, t, sub) => node(sk, x, y, 200, 56, t, { font: 'mono', s: 12, sub });
    gate(240, 60, 'Flash eligible?', 'CUDA, fp16/bf16, d ≤ 256, no tensor mask');
    gate(240, 250, 'mem-efficient eligible?', 'CUDA, d ≤ 256 (simplified)');
    node(sk, 560, 60, 180, 56, 'FlashAttention', { s: 20, fill: pick === 'flash' ? 'accent' : 'paper' });
    node(sk, 560, 200, 180, 56, 'memory-efficient', { s: 20, fill: pick === 'mem' ? 'accent' : 'paper' });
    node(sk, 560, 330, 180, 56, 'math fallback', { s: 20, fill: pick === 'math' ? 'accent' : 'paper' });
    const P = (d, on) => on ? sk.pop(d) : sk.thin(d);
    P(carr(182, 200, 238, 90, -14), true);
    P(Ink.arr(442, 88, 556, 88), flash); sk.mono(500, 80, 'yes', { s: 11 });
    P(carr(340, 118, 340, 246, 0), !flash); sk.mono(354, 186, 'no', { s: 11, a: 'start' });
    P(carr(442, 270, 556, 230, -10), pick === 'mem'); sk.mono(500, 236, 'yes', { s: 11 });
    P(carr(442, 290, 556, 356, 10), pick === 'math'); sk.mono(500, 340, 'no', { s: 11 });
    const why = !st.cuda ? 'not on a CUDA GPU' : !half ? 'fp32 inputs' : st.hd > 256 ? 'head dim above 256' : st.mask === 'tensor' ? 'explicit mask tensor' : '';
    sk.serif(860, 170, pick === 'flash' ? 'Flash ✓' : pick === 'mem' ? 'mem-efficient' : 'math', 26);
    if (why) sk.hand(860, 210, `because: ${why}`, 19, -3, { c: 'redt' });
    sk.mono(860, 250, pick === 'math' ? 'builds full L × S matrix' : 'tiles, no full matrix', { s: 12 });
  },
  controls: c => c.choice('dt', 'dtype', [['bf16', 'bf16'], ['fp16', 'fp16'], ['fp32', 'fp32']]).choice('mask', 'Mask', [['none', 'none'], ['causal', 'is_causal'], ['tensor', 'attn_mask tensor']]).choice('hd', 'Head dim', [[64, '64'], [128, '128'], [256, '256'], [512, '512']]).toggle('cuda', 'CUDA GPU')
});

fig('memory', {
  view: '0 0 980 320', hue: 195, state: { lt: 13 },
  label: 'Two bars for one layer at the chosen sequence length: memory for the full score matrix in the math backend versus the small per-tile working set of a fused kernel.',
  draw(sk, st) {
    const T = 2 ** st.lt, full = 32 * T * T * 2, stats = 32 * T * 4, top = Math.log10(32 * 2 ** 34 * 2);
    const S = v => clamp(760 * (Math.log10(v) - 3) / (top - 3), 4, 760);
    [['math: [1, 32, T, T] scores', full, false], ['fused: per-row max and sum', stats, true]].forEach(([t, v, acc], i) => {
      const y = 70 + i * 100, w = S(v);
      acc ? sk.accent(rect(200, y, w, 50)) : sk.cell(rect(200, y, w, 50), 0.4); sk.ink(box(200, y, w, 50, i));
      sk.mono(190, y + 30, t, { a: 'end', s: 11.5 }); sk.mono(210 + w, y + 30, fmtBytes(v), { a: 'start', s: 12 });
    });
    sk.hand(490, 290, `T = ${fmtN(T)} · log-scaled bar lengths`, 20, -2, { c: 'tint' });
  },
  controls: c => c.slider('lt', 'Sequence length', 10, 17, 1, v => fmtN(2 ** v))
});

fig('boolmask', {
  view: '0 0 980 340', hue: 195, state: { flip: false },
  label: 'A padding mask for a sequence of three real tokens and two pads, shown as booleans and as the equivalent float mask. With the wrong polarity, real tokens attend only to the pad columns, marked in red.',
  draw(sk, st) {
    const toks = ['I', 'like', 'tea', 'pad', 'pad'], real = j => j < 3;
    const B = toks.map(() => toks.map((_, j) => st.flip ? !real(j) : real(j)));
    B.forEach((row, i) => row.forEach((v, j) => { const X = 120 + j * 52, Y = 50 + i * 46; v ? sk.cell(rect(X, Y, 52, 46), st.flip && !real(j) ? 0.9 : 0.6) : sk.fill(rect(X, Y, 52, 46), 'sk-sunk'); sk.mono(X + 26, Y + 28, v ? 'True' : 'False', { s: 10.5, c: v ? '' : 'muted' }); if (v && st.flip) sk.red(box(X + 3, Y + 3, 46, 40, i + j)); }));
    sk.ink(box(120, 50, 260, 230, 1));
    toks.forEach((t, j) => sk.mono(146 + j * 52, 40, t, { s: 11 }));
    sk.hand(250, 316, st.flip ? 'True meant “is padding” in your code' : 'True = may attend', 20, -2, { c: st.flip ? 'redt' : 'tint' });
    sk.ink(arr(420, 160, 480, 160)); sk.mono(450, 148, 'same as', { s: 11 });
    B.forEach((row, i) => row.forEach((v, j) => { const X = 520 + j * 52, Y = 50 + i * 46; v ? sk.cell(rect(X, Y, 52, 46), 0.3) : sk.fill(rect(X, Y, 52, 46), 'sk-sunk'); sk.mono(X + 26, Y + 28, v ? '0' : '−∞', { s: 12, c: v ? '' : 'muted' }); }));
    sk.ink(box(520, 50, 260, 230, 2));
    sk.hand(650, 316, 'float mask: added to scores', 20, -2);
  },
  controls: c => c.toggle('flip', 'Pass an inverted padding mask')
});

fig('alignment', {
  view: '0 0 980 380', hue: 195, state: { L: 1 },
  label: 'Two L by 8 grids for query length L and key length 8. Top-left alignment, which is what is_causal uses, lets the last queries see only the first keys. Bottom-right alignment, which decode needs, lets the newest query see every key.',
  draw(sk, st) {
    const L = st.L, S = 8, c = 34;
    const grid = (x0, f, t, bad) => {
      for (let i = 0; i < L; i++) for (let j = 0; j < S; j++) { const X = x0 + j * c, Y = 60 + (8 - L) * c + i * c; f(i, j) ? sk.cell(rect(X, Y, c, c), 0.75) : sk.fill(rect(X, Y, c, c), 'sk-sunk'); }
      sk.ink(box(x0, 60 + (8 - L) * c, S * c, L * c, x0));
      sk.hand(x0 + S * c / 2, 44, t, 21, -2, { c: bad ? 'redt' : 'tint' });
      for (let j = 0; j < S; j++) sk.mono(x0 + j * c + c / 2, 360, `k${j}`, { s: 10 });
    };
    grid(60, (i, j) => j <= i, 'is_causal=True (top-left)', L < S);
    grid(560, (i, j) => j <= i + (S - L), 'what decode needs (bottom-right)', false);
    if (L < S) sk.hand(200, 350 - L * c - 40, `newest token sees ${L} key${L > 1 ? 's' : ''} only`, 18, -3, { c: 'redt' });
    sk.mono(490, 200, `L = ${L}, S = 8`, { s: 13 });
  },
  controls: c => c.choice('L', 'Query length L', [[1, '1 (decode)'], [3, '3'], [8, '8 (training)']]).note('fix: is_causal=False for 1 query, or causal_lower_right')
});

const stages = [['[B, T, h·d]', 'after q_proj'], ['[B, T, h, d]', '.view(B, T, h, d)'], ['[B, h, T, d]', '.transpose(1, 2)'], ['[B, h, T, d]', 'SDPA'], ['[B, T, h, d]', '.transpose(1, 2)'], ['[B, T, h·d]', '.reshape(B, T, h·d)']];
fig('layout', {
  view: '0 0 980 300', hue: 195,
  label: 'Six shape chips in sequence from B T h d after the projection, through view, transpose to B h T d, SDPA, transpose back, and reshape.',
  draw(sk, st) {
    stages.forEach(([s, t], i) => {
      const x = 20 + i * 160, on = i === st.step;
      chip(sk, x, 110, 140, 50, s, { hi: on, dim: i > st.step, s: 13 });
      sk.mono(x + 70, 190, t, { s: 11, c: i > st.step ? 'muted' : '' });
      if (i < 5) sk.ink(arr(x + 142, 135, x + 158, 135));
    });
    if (st.step >= 2 && st.step <= 3) sk.hand(420, 70, 'heads before time: what SDPA expects', 21, -2, { c: 'tint' });
    if (st.step >= 4) sk.hand(820, 70, 'back to one vector per token', 21, -2, { c: 'tint' });
  },
  controls: c => c.player('step', stages.length, { ms: 900, name: 'step' })
});

fig('force', {
  view: '0 0 980 300', hue: 195,
  label: 'A code card using torch.nn.attention.sdpa_kernel with SDPBackend.FLASH_ATTENTION to force FlashAttention, raising an error if inputs are not supported.',
  draw(sk) {
    code(sk, ['from torch.nn.attention import sdpa_kernel, SDPBackend', '', 'with sdpa_kernel(SDPBackend.FLASH_ATTENTION):', '    out = F.scaled_dot_product_attention(q, k, v, is_causal=True)', '', '# fp32 inputs here → RuntimeError: No available kernel'], 30, 40, { w: 640, s: 12.5, lh: 32, hi: [2], red: [5] });
    sk.hand(830, 110, 'only Flash allowed', 21, -4, { c: 'tint' }); sk.ink(arr(780, 116, 680, 120));
    sk.hand(830, 220, 'a loud failure beats a silent slow path', 19, -3); sk.ink(arr(780, 226, 680, 228));
  }
});

const Ed = { view: '0 0 240 110', hue: 195 };
fig('e-both', { ...Ed, draw(sk) { sk.mono(120, 40, 'attn_mask=m,', { s: 13 }); sk.mono(120, 64, 'is_causal=True', { s: 13 }); sk.hand(120, 96, 'error', 20, -3, { c: 'redt' }); } });
fig('e-drop', { ...Ed, draw(sk) { sk.mono(120, 40, 'model.eval()', { s: 13 }); sk.mono(120, 68, 'dropout_p=0.1', { s: 13, c: 'redt' }); sk.hand(120, 98, 'still dropping', 17, -3, { c: 'redt' }); } });
fig('e-nan', { ...Ed, draw(sk) { ['F', 'F', 'F', 'F'].forEach((t, i) => chip(sk, 20 + i * 44, 34, 38, 28, t, { dim: true, s: 12 })); sk.ink(arr(200, 48, 214, 48)); sk.hand(226, 54, 'NaN', 16, -6, { c: 'redt' }); } });
fig('e-fp32', { ...Ed, draw(sk) { chip(sk, 30, 36, 70, 30, 'fp32', { red: true, s: 12 }); sk.ink(arr(104, 51, 136, 51)); chip(sk, 140, 36, 70, 30, 'math', { s: 12 }); } });
fig('e-scale', { ...Ed, draw(sk) { sk.mono(120, 44, 'scale=None → 1/√E', { s: 13 }); sk.mono(120, 72, 'QK-norm? pass your own', { s: 11 }); } });
  </script></Fragment>
</Note>
