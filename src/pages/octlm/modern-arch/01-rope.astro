---
import Note from '../../../layouts/Note.astro';
---
<Note ch={1} description="RoPE at implementation depth: where it sits, inverse frequencies and base, cos and sin caches, interleaved versus half-split pairing, rotate_half, KV cache positions, relative structure and long-context scaling.">
  <header class="hero">
    <div>
      <p class="kicker">chapter 01</p>
      <h1><span>RoPE</span>, properly</h1>
      <p class="lede">Day 1 introduced the idea: rotate queries and keys by their position, and the dot product sees only the distance.</p>
    </div>
  </header>

  <h2>Where it lives</h2>
  <figure class="fig" id="where">
    <div class="fig-head"><h3>RoPE inside one attention layer, with shapes</h3></div>
  </figure>

  <h2>The frequency table</h2>
  <figure class="fig" id="freqs">
    <div class="fig-head"><h3>One frequency per pair, set by the base</h3></div>
    <div class="formula">inv_freq = 1 / <em>base</em> ** (arange(0, d_h, 2) / d_h) &nbsp; &nbsp; wavelength<sub>i</sub> = 2π / θ<sub>i</sub></div>
  </figure>

  <figure class="fig" id="table">
    <div class="fig-head"><h3>Build cos and sin once, look them up forever</h3></div>
  </figure>

  <h2>Pairing and rotate_half</h2>
  <figure class="fig" id="pairing">
    <div class="fig-head"><h3>Two ways to choose the pairs</h3></div>
  </figure>

  <figure class="fig" id="rotatehalf">
    <div class="fig-head"><h3>rotate_half, step by step</h3></div>
    <div class="formula">rotate_half([x₁, x₂]) = [<em>−x₂</em>, x₁] &nbsp; &nbsp; q′ = q · cos + rotate_half(q) · sin</div>
  </figure>

  <h2>Positions at decode time</h2>
  <figure class="fig" id="decode">
    <div class="fig-head"><h3>The new token starts where the cache ends</h3></div>
    <div class="formula">position_ids = <em>cache_len</em> + arange(new_tokens)</div>
  </figure>

  <figure class="fig" id="toeplitz">
    <div class="fig-head"><h3>Proof by picture: scores depend only on distance</h3></div>
  </figure>

  <h2>Stretching to longer contexts</h2>
  <figure class="fig" id="scaling">
    <div class="fig-head"><h3>Interpolation, NTK-aware, YaRN</h3></div>
  </figure>

  <h2>Exceptions and sharp edges</h2>
  <div class="edges">
    <article class="edge redraw" id="e-v"><div class="art"></div><h4>Rotating v</h4><span class="fix">rotate exactly q and k.</span></article>
    <article class="edge redraw" id="e-base"><div class="art"></div><h4>Wrong base at inference</h4><span class="fix">read rope_theta from the config, never hardcode it.</span></article>
    <article class="edge redraw" id="e-perm"><div class="art"></div><h4>Converted checkpoints</h4><span class="fix">use the conversion script that ships with the model.</span></article>
    <article class="edge redraw" id="e-pad"><div class="art"></div><h4>Left padding</h4><span class="fix">derive position_ids from the attention mask.</span></article>
    <article class="edge redraw" id="e-dtype"><div class="art"></div><h4>Low-precision tables</h4><span class="fix">build inv_freq and angles in fp32, cast cos and sin at the end.</span></article>
    <article class="edge redraw" id="e-partial"><div class="art"></div><h4>Partial rotary</h4><span class="fix">check for a rotary fraction or rotary_dim in the config.</span></article>
  </div>

  <Fragment slot="scripts"><script is:inline>
const { fig, box, rect, o, arr, carr, ln, node, chip, heat, vec, bars, axes, smooth, cross, check, squig, clamp, map, gauss, dot, norm, code, fmtN } = Ink;
const inv = (i, d, base) => base ** (-2 * i / d);
const ropeHalf = (x, m, base = 10000) => { const d = x.length, h = d / 2; return x.map((_, j) => { const i = j % h, a = m * inv(i, d, base), c = Math.cos(a), s = Math.sin(a); return j < h ? x[j] * c - x[j + h] * s : x[j] * c + x[j - h] * s; }); };

fig('where', {
  view: '0 0 980 400', hue: 300,
  label: 'Attention layer data flow. x of shape B T d goes through q, k and v projections, is reshaped to B heads T head-dim, q and k pass through an apply RoPE block using cos and sin tables, k and v go to the KV cache, and all meet in SDPA.',
  draw(sk) {
    node(sk, 20, 170, 110, 56, 'x', { font: 'serif', s: 26, sub: '[B, T, d]' });
    const rows = [['q_proj', 'B, h, T, dₕ', 60, true], ['k_proj', 'B, h_kv, T, dₕ', 175, true], ['v_proj', 'B, h_kv, T, dₕ', 290, false]];
    rows.forEach(([t, sh, y, rot], i) => {
      sk.ink(carr(132, 198, 178, y + 22, i === 1 ? 0 : i ? 18 : -18));
      node(sk, 180, y, 100, 44, t, { font: 'mono', s: 13 });
      sk.ink(arr(282, y + 22, 318, y + 22));
      chip(sk, 320, y + 4, 150, 36, `[${sh}]`, { s: 11.5 });
      sk.mono(395, y + 56, 'view + transpose', { s: 9.5, c: 'muted' });
      sk.ink(arr(472, y + 22, 520, y + 22));
      if (rot) node(sk, 522, y - 2, 130, 48, 'apply_rope', { font: 'mono', s: 13, fill: 'accent', sub: 'cos[pos], sin[pos]' });
      else { sk.dash(`M522 ${y + 22}H652`); sk.hand(587, y + 12, 'no rotation', 18, -3, { c: 'redt' }); }
    });
    node(sk, 540, 362, 100, 30, 'cos / sin', { font: 'mono', s: 11 });
    sk.dash('M590 360V231M590 168V116');
    node(sk, 700, 200, 120, 130, 'KV cache', { font: 'mono', s: 13, sub: 'rotated k, plain v' });
    sk.ink(carr(654, 197, 698, 232, 10)); sk.ink(arr(654, 312, 698, 300));
    node(sk, 860, 100, 104, 80, 'SDPA', { font: 'mono', s: 15, fill: 'accent' });
    sk.ink(carr(654, 82, 858, 124, -14)); sk.ink(carr(822, 230, 900, 184, 20));
    sk.hand(780, 46, 'fresh rotated q', 18, -3);
  }
});

fig('freqs', {
  view: '0 0 980 340', hue: 300, state: { base: 500000, ctx: 8192 },
  label: 'Bar chart of wavelength in tokens for each of 64 rotation pairs on a log axis, with a dashed horizontal line at the context length. The number of pairs that never complete a turn is shown.',
  draw(sk, st) {
    const d = 128, n = 64, Y = v => map(Math.log10(v), 0.5, 7.2, 280, 30);
    axes(sk, 70, 30, 880, 250, { xl: 'pair i (fast → slow)', yl: 'wavelength, tokens (log)' });
    let slow = 0;
    for (let i = 0; i < n; i++) {
      const wl = 2 * Math.PI / inv(i, d, st.base), x = 80 + i * 13.6, y = Y(wl), over = wl > st.ctx;
      if (over) slow++;
      const p = `M${x} ${y} ${x + 10} ${y} ${x + 10} 280 ${x} 280Z`;
      over ? sk.accent(p) : sk.cell(p, 0.3);
    }
    [10, 1000, 100000].forEach(v => { sk.mono(62, Y(v) + 4, fmtN(v), { a: 'end', s: 10 }); sk.thin(`M66 ${Y(v)}h8`); });
    sk.red(`M70 ${Y(st.ctx)}H950`); sk.hand(120, Y(st.ctx) - 8, `context ${fmtN(st.ctx)}`, 19, -2, { a: 'start', c: 'redt' });
    sk.serif(720, 70, `${slow} of 64 pairs never wrap`, 24);
    sk.mono(720, 98, `base ${st.base.toLocaleString()} · slowest ≈ ${fmtN(2 * Math.PI / inv(63, d, st.base))} tokens`, { s: 12 });
  },
  controls: c => c.choice('base', 'Base', [[10000, '10k (2017, Llama 2)'], [500000, '500k (Llama 3)'], [1000000, '1M (Qwen 2.5)']]).choice('ctx', 'Context', [[4096, '4k'], [8192, '8k'], [131072, '128k']])
});

fig('table', {
  view: '0 0 980 400', hue: 300, state: { m: 12 },
  label: 'A code card building inverse frequencies, angles, cos and sin. Next to it, two heatmaps: cos and sin of position times theta for 48 positions and 32 pairs, with the chosen position row highlighted.',
  draw(sk, st) {
    code(sk, ['inv_freq = 1 / base ** (arange(0, d_h, 2) / d_h)', 'pos      = arange(max_len).float()', 'angles   = outer(pos, inv_freq)   # [T, d_h/2]', 'emb      = cat([angles, angles], -1)  # [T, d_h]', 'cos, sin = emb.cos(), emb.sin()', '', '# at run time', 'c, s = cos[position_ids], sin[position_ids]'], 20, 30, { w: 420, s: 11, lh: 24, hi: [2, 7] });
    const d = 64, P = 48, A = Array.from({ length: P }, (_, m) => Array.from({ length: 32 }, (_, i) => m * inv(i, d, 10000)));
    heat(sk, A.map(r => r.map(Math.cos)), 470, 40, 7.4, 6.6, { max: 1, grid: false });
    heat(sk, A.map(r => r.map(Math.sin)), 730, 40, 7.4, 6.6, { max: 1, grid: false });
    sk.hand(588, 30, 'cos', 22, -3); sk.hand(848, 30, 'sin', 22, -3);
    [470, 730].forEach(x => sk.pop(box(x - 3, 40 + st.m * 6.6 - 2, 32 * 7.4 + 6, 10, 2)));
    sk.mono(462, 44, 'pos 0', { a: 'end', s: 10 }); sk.mono(462, 40 + 47 * 6.6, 'pos 47', { a: 'end', s: 10 });
    sk.mono(470, 380, 'pair 0', { a: 'start', s: 10 }); sk.mono(706, 380, 'pair 31', { a: 'end', s: 10 });
    sk.hand(700, 386, `row ${st.m} = what token ${st.m} gets`, 19, -1, { c: 'tint' });
  },
  controls: c => c.slider('m', 'Position', 0, 47, 1)
});

fig('pairing', {
  view: '0 0 980 330', hue: 300, state: { mode: 'half' },
  label: 'Eight head dimensions as chips with arcs joining the pairs that rotate together. Interleaved pairs neighbours; half-split pairs dimension i with i plus four.',
  draw(sk, st) {
    const xs = Array.from({ length: 8 }, (_, i) => 120 + i * 96);
    xs.forEach((x, i) => chip(sk, x - 36, 170, 72, 40, `d${i}`, { hi: st.mode === 'half' ? i < 4 : i % 2 === 0, s: 14 }));
    const pairs = st.mode === 'half' ? [0, 1, 2, 3].map(i => [i, i + 4]) : [0, 2, 4, 6].map(i => [i, i + 1]);
    pairs.forEach(([a, b], k) => {
      const h = st.mode === 'half' ? 40 + k * 18 : 40;
      sk.pop(`M${xs[a]} 166C${xs[a]} ${166 - h * 2} ${xs[b]} ${166 - h * 2} ${xs[b]} 166`);
      sk.mono((xs[a] + xs[b]) / 2, 160 - h * 1.5 - 6, `θ${k}`, { s: 12 });
    });
    sk.hand(490, 260, st.mode === 'half' ? 'half-split: GPT-NeoX, Llama (HF), most code today' : 'interleaved: RoFormer paper, GPT-J, Meta original Llama code', 21, -1, { c: 'tint' });
    sk.mono(490, 300, st.mode === 'half' ? 'rotate_half: [x₀…x₃, x₄…x₇] → [−x₄…−x₇, x₀…x₃]' : 'pairs (x₀,x₁) → (−x₁, x₀), (x₂,x₃) → (−x₃, x₂) …', { s: 13 });
  },
  controls: c => c.choice('mode', 'Convention', [['half', 'Half-split'], ['inter', 'Interleaved']])
});

const qx = [0.8, -0.3, 0.5, 0.9, 0.4, 0.7, -0.6, 0.2];
fig('rotatehalf', {
  view: '0 0 980 420', hue: 300, state: { m: 3 },
  label: 'Rows of numbers for an 8 dimensional query: the input, cos and sin rows for the position, rotate_half of the input, the two products, the sum, and a check against explicit rotation.',
  draw(sk, st) {
    const d = 8, h = 4, base = 100, ang = Array.from({ length: d }, (_, j) => st.m * inv(j % h, d, base));
    const c = ang.map(Math.cos), s = ang.map(Math.sin), rh = qx.map((_, j) => j < h ? -qx[j + h] : qx[j - h]);
    const a = qx.map((v, j) => v * c[j]), b = rh.map((v, j) => v * s[j]), out = a.map((v, j) => v + b[j]);
    const ref = ropeHalf(qx, st.m, base);
    const rows = [['q', qx], ['cos', c], ['sin', s], ['rotate_half(q)', rh], ['q · cos', a], ['rot · sin', b], ['q′ = sum', out]];
    rows.slice(0, st.step + 1).forEach(([t, v], r) => {
      const y = 20 + r * 52;
      sk.mono(176, y + 22, t, { a: 'end', s: 12.5 });
      vec(sk, v, 190, y, 74, 34, { nums: true, max: 1.2, fmt: n => n.toFixed(2), numS: 11.5 });
      if (r === 3) for (let j = 0; j < 4; j++) sk.thin(`M${190 + j * 74 + 37} ${y - 18}L${190 + (j + 4) * 74 + 37} ${y}`);
    });
    if (st.step >= 6) {
      const ok = out.every((v, j) => Math.abs(v - ref[j]) < 1e-12);
      sk.mono(800, 400, `explicit 2×2 rotation per pair: ${ok ? 'match' : 'mismatch'}`, { s: 12 });
      ok ? sk.ink(check(930, 392, 0.7)) : sk.red(cross(940, 396, 8));
      sk.pop(box(186, 20 + 6 * 52 - 4, 8 * 74 + 8, 42, 3));
    }
    sk.hand(860, 40, `m = ${st.m}`, 26, -4, { c: 'tint' });
  },
  controls: c => c.player('step', 7, { ms: 1000, name: 'row' }).slider('m', 'Position m', 0, 20, 1)
});

const words = ['The', 'cat', 'sat', 'because', 'it', 'was', 'tired', 'and'];
fig('decode', {
  view: '0 0 980 340', hue: 300,
  label: 'Key cache chips each with a small dial showing its rotation angle. Prefill rotates positions 0 to 4. Each decode step adds one token at the next position.',
  draw(sk, st) {
    const n = 5 + st.step, w = 104;
    sk.ink('M30 250H950'); sk.hand(90, 290, 'KV cache', 22, -3);
    for (let i = 0; i < n; i++) {
      const x = 40 + i * 112, cx = x + w / 2, isNew = st.step > 0 && i === n - 1, a = i * 0.55;
      isNew ? sk.accent(box(x, 120, w, 126, i)) : sk.paper(box(x, 120, w, 126, i));
      sk.ink(box(x, 120, w, 126, i));
      sk.ink(o(cx, 166, 26)); sk.pop(`M${cx} 166L${(cx + Math.cos(a) * 22).toFixed(1)} ${(166 - Math.sin(a) * 22).toFixed(1)}`);
      sk.mono(cx, 214, words[i], { s: 12 }); sk.mono(cx, 234, `pos ${i}`, { s: 11, c: 'muted' });
    }
    if (st.step === 0) sk.hand(320, 80, 'prefill: positions 0…4 rotated in one pass', 22, -2, { c: 'tint' });
    else { sk.hand(40 + (n - 1) * 112 + 52, 80, `cache_len = ${n - 1} → pos ${n - 1}`, 20, -3, { c: 'tint' }); sk.ink(arr(40 + (n - 1) * 112 + 52, 90, 40 + (n - 1) * 112 + 52, 116)); }
  },
  controls: c => c.player('step', 4, { ms: 1300, name: 'step' })
});

const u = [0.9, 0.3, -0.4, 0.7, 0.2, -0.6, 0.5, 0.1], w2 = [0.6, -0.2, 0.8, 0.3, -0.5, 0.4, 0.1, 0.7];
const Pabs = Array.from({ length: 16 }, (_, m) => u.map((_, j) => gauss(m + 5, j) * 0.7));
fig('toeplitz', {
  view: '0 0 980 400', hue: 300, state: { mode: 'rope' },
  label: 'A 16 by 16 score matrix for identical content at every position. With RoPE every diagonal holds one constant value. With learned absolute positions values vary along each diagonal.',
  draw(sk, st) {
    const n = 16, S = Array.from({ length: n }, (_, m) => Array.from({ length: n }, (_, k) => st.mode === 'rope' ? dot(ropeHalf(u, m, 100), ropeHalf(w2, k, 100)) : dot(u.map((v, j) => v + Pabs[m][j]), w2.map((v, j) => v + Pabs[k][j]))));
    heat(sk, S, 90, 30, 21, 21, { grid: false });
    for (let k = 0; k < n - 3; k++) sk.pop(box(90 + k * 21 + 1, 30 + (k + 3) * 21 + 1, 19, 19, k));
    sk.mono(258, 384, 'key position n →', { s: 11 }); sk.mono(80, 200, 'm', { a: 'end', s: 11 });
    const diag = Array.from({ length: n - 3 }, (_, k) => S[k + 3][k]), spread = Math.max(...diag) - Math.min(...diag);
    sk.serif(700, 120, st.mode === 'rope' ? 'RoPE' : 'learned absolute', 28);
    sk.mono(700, 156, `outlined diagonal (m − n = 3): spread ${spread.toExponential(1)}`, { s: 12 });
    sk.hand(700, 220, spread < 1e-9 ? 'constant: only distance matters' : 'varies: absolute position leaks in', 22, -2, { c: spread < 1e-9 ? 'tint' : 'redt' });
  },
  controls: c => c.choice('mode', 'Positions', [['rope', 'RoPE'], ['abs', 'Learned absolute']])
});

fig('scaling', {
  view: '0 0 980 360', hue: 300, state: { m: 'yarn', s: 4 },
  label: 'Line chart of the factor by which each rotation pair is slowed, against pair index, for linear position interpolation, NTK-aware base scaling and YaRN, for the chosen extension factor.',
  draw(sk, st) {
    const d = 128, n = 64, s = st.s, base = 10000, L = 4096;
    const f = i => {
      if (st.m === 'pi') return s;
      if (st.m === 'ntk') { const nb = base * s ** (d / (d - 2)); return inv(i, d, base) / inv(i, d, nb); }
      const wl = 2 * Math.PI / inv(i, d, base), r = L / wl, lo = 1, hi = 32;
      const g = clamp((r - lo) / (hi - lo), 0, 1);
      return 1 / (g + (1 - g) / s);
    };
    const X = i => map(i, 0, n - 1, 90, 920), Y = v => map(v, 1, s * 1.05, 290, 40);
    axes(sk, 90, 40, 840, 250, { xl: 'pair i: fast → slow', yl: 'slow-down factor' });
    sk.dash(`M90 ${Y(s)}H930`); sk.mono(92, Y(s) - 6, `× ${s}`, { a: 'start', s: 11 });
    sk.thin(`M90 ${Y(1)}H930`); sk.mono(84, Y(1) + 4, '1', { a: 'end', s: 11 });
    const pts = Array.from({ length: n }, (_, i) => [X(i), Y(f(i))]);
    sk.plot(smooth(pts), 'pop');
    const note = { pi: 'linear interpolation: every pair slowed equally, local detail gets blurred', ntk: 'NTK-aware: raise the base, fast pairs barely move, slow pairs stretch', yarn: 'YaRN: fast pairs untouched, slow pairs fully interpolated, a ramp between' }[st.m];
    sk.hand(510, 336, note, 19, -1, { c: 'tint' });
  },
  controls: c => c.choice('m', 'Method', [['pi', 'Linear PI'], ['ntk', 'NTK-aware'], ['yarn', 'YaRN']]).choice('s', 'Extend', [[2, '2×'], [4, '4×'], [8, '8×']])
});

const Ed = { view: '0 0 240 110', hue: 300 };
fig('e-v', { ...Ed, draw(sk) { ['q', 'k', 'v'].forEach((t, i) => node(sk, 20 + i * 74, 34, 56, 40, t, { font: 'serif', fill: i < 2 ? 'accent' : 'paper' })); sk.red(cross(196, 26, 8)); } });
fig('e-base', { ...Ed, draw(sk) { sk.mono(120, 40, 'trained: 500000', { s: 13 }); sk.mono(120, 70, 'loaded:   10000', { s: 13, c: 'redt' }); } });
fig('e-perm', { ...Ed, draw(sk) { for (let i = 0; i < 6; i++) chip(sk, 20 + i * 34, 22, 30, 24, String(i), { s: 11 }); [0, 3, 1, 4, 2, 5].forEach((v, i) => chip(sk, 20 + i * 34, 72, 30, 24, String(v), { s: 11, hi: true })); for (let i = 0; i < 6; i++) sk.thin(`M${35 + i * 34} 48L${35 + [0, 2, 4, 1, 3, 5][i] * 34} 70`); } });
fig('e-pad', { ...Ed, draw(sk) { ['pad', 'pad', 'hi', 'you'].forEach((t, i) => chip(sk, 20 + i * 52, 34, 46, 28, t, { dim: i < 2, hi: i === 2, s: 11, sub: i < 2 ? '' : `pos ${i}?` })); } });
fig('e-dtype', { ...Ed, draw(sk) { sk.mono(120, 40, '100000 · θ₀ in bf16', { s: 12 }); sk.mono(120, 68, '= 99840 · θ₀', { s: 13, c: 'redt' }); } });
fig('e-partial', { ...Ed, draw(sk) { for (let i = 0; i < 8; i++) chip(sk, 18 + i * 26, 40, 22, 26, i < 2 ? '↻' : '·', { hi: i < 2, s: 12 }); sk.mono(120, 94, 'rotary_dim = 32 of 128', { s: 10.5 }); } });
  </script></Fragment>
</Note>
