---
import Note from '../../../layouts/Note.astro';
---
<Note ch={11} description="The KV cache drawn: generation with and without caching, work saved, cache size arithmetic, prefill versus decode, why queries are not cached, and how GQA shrinks the cache.">
  <header class="hero">
    <div>
      <p class="kicker">chapter 11</p>
      <h1><span>KV cache</span></h1>
      <p class="lede">Generation adds one token at a time.</p>
    </div>
  </header>

  <h2>Without and with a cache</h2>
  <figure class="fig" id="nocache">
    <div class="fig-head"><h3>No cache: redo everything, every step</h3></div>
  </figure>

  <figure class="fig" id="cache">
    <div class="fig-head"><h3>With a cache: compute one row, append, look up the rest</h3></div>
  </figure>

  <figure class="fig" id="work">
    <div class="fig-head"><h3>Work saved</h3></div>
  </figure>

  <h2>Why K and V, but not Q</h2>
  <figure class="fig" id="whynotq">
    <div class="fig-head"><h3>Old queries are never asked again</h3></div>
  </figure>

  <h2>The cost: memory</h2>
  <figure class="fig" id="size">
    <div class="fig-head"><h3>KV cache size calculator</h3></div>
    <div class="formula">bytes = <em>2</em> × layers × kv_heads × head_dim × <em>tokens</em> × batch × bytes_per_value</div>
  </figure>

  <figure class="fig" id="gqa">
    <div class="fig-head"><h3>Sharing K and V shrinks the cache</h3></div>
  </figure>

  <figure class="fig" id="phases">
    <div class="fig-head"><h3>Prefill, then decode</h3></div>
  </figure>

  <h2>Exceptions and sharp edges</h2>
  <div class="edges">
    <article class="edge redraw" id="e-edit"><div class="art"></div><h4>Editing an earlier token</h4><span class="fix">truncate the cache at the edit and recompute from there.</span></article>
    <article class="edge redraw" id="e-pos"><div class="art"></div><h4>Position offset</h4><span class="fix">pass cache length as the position offset.</span></article>
    <article class="edge redraw" id="e-batch"><div class="art"></div><h4>Ragged batches</h4><span class="fix">paged attention stores the cache in fixed-size blocks.</span></article>
    <article class="edge redraw" id="e-evict"><div class="art"></div><h4>Evicting old entries</h4><span class="fix">keep the first few tokens plus a recent window.</span></article>
    <article class="edge redraw" id="e-quant"><div class="art"></div><h4>Quantised caches</h4><span class="fix">measure on long-context tasks before shipping.</span></article>
    <article class="edge redraw" id="e-prefix"><div class="art"></div><h4>Shared prefixes</h4><span class="fix">prompt caching reuses the prefix's KV blocks.</span></article>
  </div>

  <Fragment slot="scripts"><script is:inline>
const { fig, box, rect, o, arr, carr, ln, node, chip, heat, vec, bars, axes, smooth, cross, check, squig, clamp, map, gauss, fmtN, fmtBytes } = Ink;
const words = ['The', 'cat', 'sat', 'because', 'it', 'was', 'tired', 'and', 'slept'];
const P = 6, STEPS = words.length - P + 1;

fig('nocache', {
  view: '0 0 960 380', hue: 85,
  label: 'Each generation step is a row of K V computation cells, one per token so far. Without a cache every row recomputes all previous tokens, shown in the accent colour as wasted work.',
  draw(sk, st) {
    let waste = 0, total = 0;
    for (let s = 0; s <= st.step; s++) {
      const n = P + s, y = 40 + s * 70;
      sk.mono(80, y + 22, `step ${s + 1}`, { a: 'end', s: 12 });
      for (let i = 0; i < n; i++) {
        const x = 96 + i * 82, old = s > 0 && i < n - 1;
        chip(sk, x, y, 74, 34, words[i], { hi: old, dim: !old && s === 0 ? false : !old ? false : false, s: 11 });
        if (old) waste++; total++;
      }
      sk.mono(96 + n * 82 + 6, y + 22, `+ ${n} K,V`, { a: 'start', s: 11 });
    }
    sk.serif(760, 340, `${total} computed, ${waste} repeated`, 22, { c: waste ? 'redt' : '' });
    sk.hand(200, 360, 'accent = recomputed for nothing', 19, -2, { c: 'redt' });
  },
  controls: c => c.player('step', STEPS, { ms: 1100, name: 'step' })
});

fig('cache', {
  view: '0 0 960 380', hue: 85,
  label: 'A shelf of cached key-value boxes grows by one each step. The new token computes q, k and v, appends k and v, and its query scores against all boxes on the shelf.',
  draw(sk, st) {
    const n = P + st.step, newI = n - 1;
    sk.ink('M40 250H920'); sk.ink('M60 250v40M900 250v40');
    sk.hand(120, 286, 'KV cache', 22, -3);
    for (let i = 0; i < n; i++) {
      const x = 60 + i * 92, isNew = i === newI && st.step > 0;
      isNew ? sk.accent(box(x, 170, 76, 78, i)) : sk.paper(box(x, 170, 76, 78, i));
      sk.ink(box(x, 170, 76, 78, i));
      sk.mono(x + 38, 200, `k${i}`, { s: 12 }); sk.mono(x + 38, 222, `v${i}`, { s: 12 });
      sk.mono(x + 38, 240, words[i], { s: 9.5, c: 'muted' });
      if (st.step > 0) sk.thin(`M${60 + newI * 92 + 38} 104Q${(60 + newI * 92 + x) / 2 + 38} 130 ${x + 38} 168`);
    }
    if (st.step > 0) {
      const x = 60 + newI * 92;
      chip(sk, x - 10, 60, 96, 40, `q${newI} ${words[newI]}`, { hi: true, s: 12 });
      sk.hand(x - 40, 40, 'new token', 20, -4, { a: 'end', c: 'tint' });
    } else sk.hand(480, 80, 'after prefill: the prompt is on the shelf', 22, -2, { c: 'tint' });
    sk.serif(760, 340, `this step: ${st.step ? 1 : P} new K,V`, 22);
  },
  controls: c => c.player('step', STEPS, { ms: 1100, name: 'step' })
});

fig('work', {
  view: '0 0 960 320', hue: 85, state: { T: 64 },
  label: 'Cumulative K and V projections against tokens generated: a quadratic curve without cache and a straight line with cache.',
  draw(sk, st) {
    const T = st.T, X = t => map(t, 0, T, 80, 900), Y = v => map(v, 0, T * (T + 1) / 2, 260, 40);
    axes(sk, 80, 40, 820, 220, { xl: 'tokens generated →', yl: 'K,V computed (total)' });
    const p1 = [], p2 = []; for (let t = 0; t <= T; t += Math.max(1, T / 64)) { p1.push([X(t), Y(t * (t + 1) / 2)]); p2.push([X(t), Y(t)]); }
    sk.plot(smooth(p1)); sk.plot(smooth(p2), 'pop');
    sk.hand(X(T * 0.72), Y(T * 0.72 * (T * 0.72 + 1) / 2) - 16, `no cache: ${fmtN(T * (T + 1) / 2)}`, 20, -6, { a: 'end' });
    sk.hand(X(T) - 10, Y(T) - 14, `cache: ${fmtN(T)}`, 20, -2, { a: 'end', c: 'tint' });
    sk.mono(480, 300, `${(T * (T + 1) / 2 / T).toFixed(1)}× less work at T = ${T}`, { s: 13 });
  },
  controls: c => c.slider('T', 'Tokens T', 8, 4096, 8)
});

fig('whynotq', {
  view: '0 0 960 360', hue: 85,
  label: 'A causal attention matrix where the last row is new. That row uses the new query and all keys and values, while the old query rows are greyed out as never used again.',
  draw(sk) {
    const n = 7, c = 40, x0 = 260, y0 = 50;
    for (let i = 0; i < n; i++) for (let j = 0; j <= i; j++) sk.cell(rect(x0 + j * c, y0 + i * c, c, c), i === n - 1 ? 0.85 : 0.15);
    for (let k = 1; k < n; k++) { sk.thin(`M${x0} ${y0 + k * c}h${n * c}`); sk.thin(`M${x0 + k * c} ${y0}v${n * c}`); }
    sk.ink(box(x0, y0, n * c, n * c, 1));
    sk.pop(box(x0 - 2, y0 + (n - 1) * c - 2, n * c + 4, c + 4, 2));
    for (let i = 0; i < n; i++) chip(sk, 170, y0 + i * c + 6, 60, 28, `q${i}`, { dim: i < n - 1, hi: i === n - 1, s: 11 });
    for (let j = 0; j < n; j++) chip(sk, x0 + j * c + 4, y0 + n * c + 12, 32, 40, `k${j}`, { s: 9.5, sub: `v${j}` });
    sk.hand(100, 130, 'never reused', 20, -8, { c: 'redt' });
    sk.ink(arr(110, 140, 162, 170));
    sk.hand(720, 300, 'the only new row', 22, -3, { c: 'tint' }); sk.ink(arr(660, 300, 548, 310));
    sk.hand(720, 120, 'all keys and values: cached', 21, -2);
    sk.ink(arr(700, 130, 560, 380));
  }
});

const presets = {
  'Llama-3 8B': { L: 32, H: 8, D: 128 },
  'Llama-3 70B': { L: 80, H: 8, D: 128 },
  'GPT-2 small (MHA)': { L: 12, H: 12, D: 64 },
};
fig('size', {
  view: '0 0 960 330', hue: 85, state: { L: 32, H: 8, D: 128, lt: 13, B: 1, bytes: 2 },
  label: 'KV cache size for the chosen configuration drawn as a bar, compared with a reference line at 80 GB, plus memory per token.',
  draw(sk, st) {
    const T = 2 ** st.lt, per = 2 * st.L * st.H * st.D * st.bytes, total = per * T * st.B;
    sk.serif(480, 60, fmtBytes(total), 46);
    sk.mono(480, 92, `${fmtBytes(per)} per token × ${T.toLocaleString()} tokens × batch ${st.B}`, { s: 13 });
    const W = 820, gb = 80 * 1024 ** 3, w = Math.min(W, W * total / gb);
    sk.paper(box(70, 140, W, 50, 2));
    total > gb ? sk.zone(rect(72, 142, W - 4, 46), true) : sk.accent(rect(72, 142, Math.max(2, w - 4), 46));
    sk.ink(box(70, 140, W, 50, 2));
    sk.mono(70, 214, '0', { s: 11 }); sk.mono(890, 214, '80 GB GPU', { s: 11, a: 'end' });
    sk.hand(480, 270, total > gb ? 'does not fit on one GPU' : `${(total / gb * 100).toFixed(1)}% of an 80 GB GPU`, 24, -2, { c: total > gb ? 'redt' : 'tint' });
  },
  controls: c => {
    Object.entries(presets).forEach(([k, v]) => c.button(k, (st, set) => set(v), 'ghost'));
    c.slider('L', 'Layers', 1, 96, 1).slider('H', 'KV heads', 1, 64, 1).slider('D', 'Head dim', 32, 256, 32).slider('lt', 'Tokens', 9, 17, 1, v => (2 ** v).toLocaleString()).slider('B', 'Batch', 1, 64, 1).choice('bytes', 'Precision', [[2, 'bf16'], [1, 'int8'], [0.5, 'int4']]);
  }
});

fig('gqa', {
  view: '0 0 960 300', hue: 85,
  label: 'Bar chart of KV cache bytes per token for a 32-layer model with head dimension 128: 32 KV heads, 8 KV heads, and 1 KV head.',
  draw(sk) {
    const vals = [32, 8, 1].map(h => 2 * 32 * h * 128 * 2);
    bars(sk, vals, 160, 50, 640, 180, { labels: ['MHA · 32 KV heads', 'GQA · 8', 'MQA · 1'], vals: true, fmt: fmtBytes, hi: 1, gap: 80, labS: 12 });
    sk.hand(800, 60, 'per token, all layers', 20, -3, { c: 'tint' });
  }
});

fig('phases', {
  view: '0 0 960 300', hue: 85,
  label: 'Timeline: a wide prefill block processes all prompt tokens in parallel, followed by a series of narrow decode blocks, one token each. Annotations: compute bound for prefill, memory bound for decode.',
  draw(sk) {
    sk.ink(arr(40, 230, 920, 230)); sk.mono(910, 252, 'time', { a: 'end', s: 11 });
    sk.accent(box(60, 90, 220, 120, 1)); sk.ink(box(60, 90, 220, 120, 1));
    for (let i = 0; i < 6; i++) sk.mono(80 + i * 36, 150, words[i].slice(0, 4), { s: 10 });
    sk.hand(170, 70, 'prefill: whole prompt at once', 20, -2);
    sk.mono(170, 270, 'compute-bound', { s: 12 });
    for (let i = 0; i < 9; i++) { const x = 320 + i * 64; sk.paper(box(x, 140, 40, 70, i)); sk.ink(box(x, 140, 40, 70, i)); sk.mono(x + 20, 180, i < 3 ? words[6 + i].slice(0, 4) : '…', { s: 10 }); if (i) sk.thin(`M${x - 24} 175h20`); }
    sk.hand(600, 110, 'decode: one token per step', 20, -2);
    sk.mono(600, 270, 'memory-bandwidth-bound', { s: 12 });
    sk.hand(860, 60, 'reads all weights + cache per token', 17, -4, { c: 'tint' });
  }
});

const Ed = { view: '0 0 240 110', hue: 85 };
fig('e-edit', { ...Ed, draw(sk) { for (let i = 0; i < 6; i++) chip(sk, 14 + i * 36, 38, 32, 30, 'kv', { s: 10, red: i >= 3 }); sk.hand(140, 98, 'stale from here', 16, -2, { c: 'redt' }); sk.ink(arr(122, 90, 122, 72)); } });
fig('e-pos', { ...Ed, draw(sk) { for (let i = 0; i < 4; i++) chip(sk, 14 + i * 40, 38, 36, 30, String(i), { s: 11 }); chip(sk, 180, 38, 44, 30, '4', { hi: true, s: 12, sub: 'not 0!' }); } });
fig('e-batch', { ...Ed, draw(sk) { [7, 3, 5].forEach((n, r) => { for (let i = 0; i < 7; i++) i < n ? sk.cell(rect(40 + i * 22, 20 + r * 24, 20, 20), 0.7) : sk.fill(rect(40 + i * 22, 20 + r * 24, 20, 20), 'sk-red-zone'); }); } });
fig('e-evict', { ...Ed, draw(sk) { for (let i = 0; i < 8; i++) chip(sk, 12 + i * 27, 40, 24, 28, i < 2 ? 's' : i < 5 ? '×' : 'r', { s: 10, hi: i < 2, dim: i >= 2 && i < 5 }); sk.mono(120, 94, 'sinks + recent window', { s: 10 }); } });
fig('e-quant', { ...Ed, draw(sk) { bars(sk, [16, 8, 4], 60, 16, 120, 60, { labels: ['bf16', 'int8', 'int4'], hi: 1, gap: 18, labS: 10 }); } });
fig('e-prefix', { ...Ed, draw(sk) { [0, 1, 2].forEach(r => { sk.accent(rect(30, 20 + r * 26, 90, 20)); sk.cell(rect(122, 20 + r * 26, 30 + r * 25, 20), 0.4); }); sk.mono(75, 104, 'shared', { s: 10 }); } });
  </script></Fragment>
</Note>
