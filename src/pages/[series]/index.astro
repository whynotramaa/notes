---
import Book from '../../layouts/Book.astro';
import { series } from '../../data/notes.js';
import { figs } from '../../lib/md.js';

export const getStaticPaths = () => series.map((s) => ({ params: { series: s.slug }, props: { s } }));
const { s } = Astro.props;
---
<Book title={`${s.title} · notes`} description={s.sub} series={s}>
  <section class="front">
    <div class="part-kicker">{s.notes.length} field guides</div>
    <h1>{s.title}</h1>
    <p class="lede">{s.sub}</p>
    <ul class="shelf">
      {s.notes.map((n) => (
        <li><a href={n.base}>
          <span class="thumb" set:html={figs[n.cover] ? figs[n.cover]() : ''} />
          <span><span class="k">{n.day} · chapter {n.chapterNumber} · {n.chapters.filter((c) => c.part).length} parts</span><strong>{n.title}</strong><p>{n.description}</p></span>
        </a></li>
      ))}
    </ul>
  </section>
</Book>
