---
import Book from '../layouts/Book.astro';
import { series } from '../data/notes.js';
import { figs } from '../lib/md.js';
---
<Book title="Notes, drawn by hand" description="Hand-drawn field guides to how machine learning systems work, written from first principles.">
  <section class="front">
    <div class="part-kicker">Hand-drawn field guides</div>
    <h1>Notes, drawn by hand</h1>
    <p class="lede">Long-form explainers on how modern machine learning systems work inside. Every idea starts from a problem you can feel, gets worked through with real numbers, and ends with the question an interviewer would ask about it. No background assumed.</p>
    <ul class="shelf">
      {series.map((s) => (
        <li><a href={s.base}>
          <span class="thumb" set:html={s.notes[0] && figs[s.notes[0].cover] ? figs[s.notes[0].cover]() : ''} />
          <span><span class="k">{s.notes.length} guides · {s.notes.reduce((a, n) => a + n.chapters.filter((c) => c.part).length, 0)} parts</span><strong>{s.title}</strong><p>{s.sub}</p></span>
        </a></li>
      ))}
    </ul>
  </section>
</Book>
