---
import '@fontsource/syne/400.css';
import '@fontsource/syne/500.css';
import '@fontsource/syne/600.css';
import '@fontsource/syne/700.css';
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource/ibm-plex-mono/600.css';
import '@fontsource/caveat/500.css';
import '@fontsource/caveat/600.css';
import '@fontsource/caveat/700.css';
import 'katex/dist/katex.min.css';
import '../styles/site.css';

const { title, description = '', note = null, series = null, current = -1 } = Astro.props;
const chapters = note?.chapters ?? [];
const prev = current > 0 ? chapters[current - 1] : current === 0 ? { href: note.base, title: 'Front matter' } : null;
const next = note && current >= -1 ? chapters[current + 1] : null;
const kicker = note ? `${series.title} · ${note.day} · chapter ${note.chapterNumber}` : 'hand-drawn field guides';
const link = (c, id, i) => (i === current ? `#${id}` : `${c.href}#${id}`);
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <script is:inline>try { const t = localStorage.getItem('fg-theme'); if (t) document.documentElement.dataset.theme = t; } catch {}</script>
</head>
<body class={note ? 'has-nav' : 'no-nav'}>
  <a class="skip" href="#top">Skip to content</a>
  <div class="progress" aria-hidden="true"><div class="progress-bar"></div></div>
  <header class="topbar">
    {note && <button class="toc-toggle" type="button" aria-expanded="false" aria-controls="sidebar">Contents</button>}
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/">notes</a>
      {series && <a href={series.base}>{series.title}</a>}
      {note && <a class="brand" href={note.base}>{note.title}</a>}
    </nav>
    <span class="topbar-meta">{kicker}</span>
    <button class="theme-btn" id="theme" type="button" aria-label="Switch between light and dark">
      <svg class="sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"/></svg>
      <svg class="moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"/></svg>
    </button>
  </header>
  <div class="layout">
    {note && (
      <nav class="sidebar" id="sidebar" aria-label="Table of contents">
        <div class="sidebar-inner">
          <div class="kicker">Contents</div>
          <ol class="nav">
            <li class="nav-part"><a href={current === -1 ? '#top' : note.base} aria-current={current === -1 ? 'page' : undefined}><span class="np-num">0</span><span>Front matter</span></a></li>
            {chapters.map((c, i) => (
              <li class="nav-part">
                <a href={i === current ? '#top' : c.href} aria-current={i === current ? 'page' : undefined}><span class="np-num">{c.part ? c.part.num : '+'}</span><span>{c.title}</span></a>
                <ol>
                  {c.sections.map((s) => <li><a href={link(c, s.id, i)}><span class="ns-num">{s.num}</span><span>{s.title}</span></a></li>)}
                  {c.extras.map((s) => <li><a href={link(c, s.id, i)}><span class="ns-num">·</span><span>{s.title}</span></a></li>)}
                </ol>
              </li>
            ))}
          </ol>
        </div>
      </nav>
    )}
    <main class="content" id="top" tabindex="-1">
      <slot />
      {note && (
        <nav class="pager" aria-label="Previous and next">
          {prev ? <a href={prev.href} rel="prev"><small>← previous</small><span>{prev.title}</span></a> : <span />}
          {next ? <a class="next" href={next.href} rel="next"><small>next →</small><span>{next.title}</span></a> : <a class="next" href={series.base}><small>done →</small><span>Back to {series.title}</span></a>}
        </nav>
      )}
    </main>
  </div>
  <div class="scrim" hidden></div>
  <script is:inline src="/site.js"></script>
</body>
</html>
