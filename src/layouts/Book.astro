---
import '@fontsource/syne/400.css';
import '@fontsource/syne/500.css';
import '@fontsource/syne/600.css';
import '@fontsource/syne/700.css';
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource/ibm-plex-mono/600.css';
import '@fontsource/caveat/500.css';
import '@fontsource/caveat/600.css';
import '@fontsource/caveat/700.css';
import 'katex/dist/katex.min.css';
import '../styles/site.css';
import { inline } from '../lib/md.js';

const { title, description = '', note = null, series = null, current = -1 } = Astro.props;
const chapters = note?.chapters ?? [];
const prev = current > 0 ? chapters[current - 1] : current === 0 ? { href: note.base, title: 'Front matter' } : null;
const next = note && current >= -1 ? chapters[current + 1] : null;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <script is:inline>try { const t = localStorage.getItem('fg-theme'); if (t) document.documentElement.dataset.theme = t; } catch {}</script>
</head>
<body class={note ? 'has-nav' : 'no-nav'}>
  <a class="skip" href="#top">Skip to content</a>
  <div class="progress" aria-hidden="true"><div class="progress-bar"></div></div>
  <header class="topbar">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/">notes</a>
      {series && <a href={series.base}>{series.title}</a>}
      {note && <a class="brand" href={note.base}>{note.title}</a>}
    </nav>
    <a class="highlights-link" href="/highlights/" aria-current={Astro.url.pathname === '/highlights/' ? 'page' : undefined}>Highlights <span data-highlight-count></span></a>
    <button class="theme-btn" id="theme" type="button" aria-label="Switch between light and dark">
      <svg class="sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"/></svg>
      <svg class="moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"/></svg>
    </button>
  </header>
  <div class="layout">
    {note && (
      <nav class="preview-rail" aria-label="Chapter navigation">
        <ol class="rail-list">
          <li class="rail-slot">
            <a class="rail-item" href={current === -1 ? '#top' : note.base} aria-label="Front matter" aria-current={current === -1 ? 'page' : undefined}>
              <span class="rail-tick" aria-hidden="true"></span>
              <span class="rail-preview" aria-hidden="true">
                <span class="rail-preview-meta">Start here</span>
                <strong>Front matter</strong>
                <span>{note.description}</span>
              </span>
            </a>
          </li>
          {chapters.map((c, i) => (
            <li class="rail-slot">
              <a class="rail-item" href={i === current ? '#top' : c.href} aria-label={`${c.part ? `Part ${c.part.num}` : 'Interview'}: ${c.title}`} aria-current={i === current ? 'page' : undefined}>
                <span class="rail-tick" aria-hidden="true"></span>
                <span class="rail-preview" aria-hidden="true">
                  <span class="rail-preview-meta">{c.part ? `Part ${c.part.num} · sections ${c.sections[0]?.num} to ${c.sections.at(-1)?.num}` : 'Interview page'}</span>
                  <strong set:html={inline(c.title)} />
                  <span set:html={inline(c.blurb || 'Question bank, graded exercises, and worked solutions.')} />
                </span>
              </a>
            </li>
          ))}
        </ol>
      </nav>
    )}
    <main class="content" id="top" tabindex="-1">
      <div class:list={['page-content', { 'guide-content': note }]} data-series={series?.title} data-guide={note?.title} data-day={note?.day} data-part={chapters[current]?.title || 'Front matter'} data-part-order={current}>
        <slot />
      </div>
      {note && (
        <nav class="pager" aria-label="Previous and next">
          {prev ? <a href={prev.href} rel="prev"><small>← previous</small><span>{prev.title}</span></a> : <span />}
          {next ? <a class="next" href={next.href} rel="next"><small>next →</small><span>{next.title}</span></a> : <a class="next" href={series.base}><small>done →</small><span>Back to {series.title}</span></a>}
        </nav>
      )}
    </main>
  </div>
  <div class="highlight-toolbar" id="highlight-toolbar" role="toolbar" aria-label="Highlight selected text" hidden>
    <button type="button" id="save-highlight" aria-keyshortcuts="Alt+A" title="Save highlight (Alt+A)">Save highlight <kbd>Alt A</kbd></button>
    <div class="highlight-colors" role="group" aria-label="Highlight color">
      {['yellow', 'red', 'pink', 'cyan', 'green', 'violet'].map(color => (
        <button type="button" class="highlight-swatch" data-highlight-color={color} aria-label={`${color} highlight`} aria-pressed="false" title={color}><span /></button>
      ))}
    </div>
    <button type="button" id="cancel-highlight" aria-label="Dismiss highlight action" title="Dismiss (Escape)"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="m4 4 8 8M12 4l-8 8" /></svg></button>
  </div>
  <p class="highlight-status" id="highlight-status" role="status" hidden></p>
  <script is:inline src="/site.js"></script>
  <script is:inline src="/highlights.js"></script>
</body>
</html>
