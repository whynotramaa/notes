---
import { series, noteAt } from '../data/notes.js';

const { ch = 0, description = '', title: pageTitle = '', hue = 25 } = Astro.props;
const note = noteAt(Astro.url.pathname);
const shelf = series.find(s => (Astro.url.pathname + '/').startsWith(s.base));
const base = note?.base ?? '/';
const chapters = note?.chapters ?? [];
const cur = chapters[ch];
const prev = chapters[ch - 1];
const next = chapters[ch + 1];
const pad = n => String(n).padStart(2, '0');
const last = chapters.length - 1;
const title = !note ? pageTitle : ch ? `${pad(ch)} · ${cur.title} · ${note.name}` : note.home;
const CH = chapters.map(c => ({ ...c, href: base + c.slug }));
---
<!doctype html>
<html lang="en" style={`--h:${cur?.hue ?? hue}`}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="preload" href="/fonts/BehindTheNineties.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/ink.css">
  <script is:inline>try { const t = localStorage.getItem('ink-theme'); if (t) document.documentElement.dataset.theme = t; } catch {}</script>
</head>
<body data-ch={ch}>
  <svg class="filter-root" aria-hidden="true"><defs><filter id="ink-edge"><feTurbulence type="fractalNoise" baseFrequency="0.03" numOctaves="2" seed="3"/><feDisplacementMap in="SourceGraphic" scale="3"/></filter></defs></svg>
  <a class="skip" href="#main">Skip to the note</a>
  <div class="progress" aria-hidden="true"></div>
  <header class="topbar">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/">notes</a>
      {shelf && <a href={shelf.base}>{shelf.title}</a>}
      {note && <a class="brand" href={base}>{note.name}<small>{note.day}</small></a>}
    </nav>
    {note && <button class="menu-btn" id="menu" type="button" aria-haspopup="dialog" aria-controls="contents"><span>{pad(ch)} / {pad(last)}</span><b class="lbl">Contents</b></button>}
    <button class="icon-btn" id="still" type="button" aria-pressed="false" aria-label="Pause motion"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6v12M15 6v12"/></svg></button>
    <button class="icon-btn" id="theme" type="button" aria-label="Toggle dark theme"><svg class="sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"/></svg><svg class="moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"/></svg></button>
  </header>
  {note && (
    <dialog class="contents" id="contents" aria-label="Contents">
      <div class="contents-in">
        <div class="contents-top">
          <p>{note.name}</p>
          <button class="icon-btn" type="button" data-close aria-label="Close contents"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg></button>
        </div>
        <ol>
          {CH.map((c, i) => (
            <li><a href={c.href} aria-current={i === ch ? 'page' : undefined}><small>{pad(i)}</small><b>{c.title}</b><i>{c.sub}</i></a></li>
          ))}
        </ol>
      </div>
    </dialog>
  )}
  <main id="main" tabindex="-1">
    <slot />
  </main>
  {note && ch > 0 && (
    <nav class="pager" aria-label="Previous and next chapter">
      <a href={base + prev.slug} rel="prev"><small>← {ch > 1 ? pad(ch - 1) : 'map'}</small><span>{prev.title}</span></a>
      {next
        ? <a class="next" href={base + next.slug} rel="next"><small>{pad(ch + 1)} →</small><span>{next.title}</span></a>
        : <a class="next" href={base}><small>done →</small><span>Back to the map</span></a>}
    </nav>
  )}
  <script is:inline define:vars={{ CH }}>window.CH = CH;</script>
  <script is:inline src="/ink.js"></script>
  <slot name="scripts" />
</body>
</html>
